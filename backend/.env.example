PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/booknexus
ATLAS_MONGO_URI=
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Resend Transactional Email Configuration
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=BookNexus
EMAIL_REPLY_TO=support@yourdomain.com
RESEND_TEST_RECIPIENT=your_registered_email@example.com
APP_BASE_URL=http://localhost:3000
EMAIL_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional Fallback SMTP
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Campus UPI Payment Configuration (Leave blank or set to unconfigured to use cash/counter desk)
CAMPUS_UPI_ID=
CAMPUS_UPI_PAYEE_NAME=BookNexus Campus Library

